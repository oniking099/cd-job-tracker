# 必需
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GLM 视觉多模态（兜底，视觉链：ModelScope → GLM；智谱 Coding Plan，glm-5.3-flash 原生多模态可读图）
# ⚠️ base_url 必须用 Coding Plan 专属端点（普通 /api/paas/v4 扣平台余额而非套餐额度）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_VL_MODEL=glm-5.3-flash

# 视觉链首选（OCR/文本失败时才动用多模态）：
#   ModelScope 魔搭 api-inference（阿里云百炼托管）
#   总配额 2000 次/天（所有模型加和），单模型最高 200 次/天（先进模型更少）
#   → 全量列出优先顺序，429/额度不足自动切下一个
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# 视觉链（VL 模型才能读图，能力优先、非思考在前；实测 Qwen3-VL 五模型可用，
# Qwen2.5-VL 无 provider；中文「千问/」前缀 400 Invalid，英文 Qwen/ 唯一正确）
MODELSCOPE_VL_MODELS=Qwen/Qwen3-VL-235B-A22B-Instruct,Qwen/Qwen3-VL-30B-A3B-Instruct,Qwen/Qwen3-VL-30B-A3B-Thinking,Qwen/Qwen3-VL-8B-Instruct,Qwen/Qwen3-VL-8B-Thinking
# 文本链（决策兜底，DeepSeek 失败时用，匹配度×能力排序，flash 收尾兜底）
MODELSCOPE_TEXT_MODELS=deepseek-ai/DeepSeek-V4-Pro,Qwen/Qwen3-Next-80B-A3B-Instruct,Qwen/Qwen3-235B-A22B-Thinking-2507,Qwen/Qwen3-30B-A3B-Thinking-2507,Qwen/Qwen3.5-397B-A17B,Qwen/Qwen3.5-35B-A3B,deepseek-ai/DeepSeek-V4-Flash-0731
#   SiliconFlow 硅基流动（仅云端 OCR 兜底 PaddleOCR-VL-1.5 永久免费；VL 已退出视觉链）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5

# 高德地图（距离计算，可选）
GAODE_API_KEY=

# Server酱（代码完成后配置）
SERVER_CHAN_SENDKEY=

# 家的坐标（高德坐标系）
HOME_LNG=103.93
HOME_LAT=30.78
