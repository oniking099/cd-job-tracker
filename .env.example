# 必需
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 视觉多模态（主力）
QWENVL_API_KEY=
QWENVL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉多模态（备用）
GEMINI_API_KEY=

# 视觉降级链（OCR/文本失败时才动用多模态）：
#   ModelScope 魔搭 api-inference（阿里云百炼托管）
#   总配额 2000 次/天（所有模型加和），单模型最高 200 次/天（先进模型更少）
#   → 全量列出优先顺序，429/额度不足自动切下一个
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# 视觉链（VL 模型才能读图，先进优先；实测 Qwen3-VL 三兄弟可用，Qwen2.5-VL 在百炼托管下无 provider）
MODELSCOPE_VL_MODELS=Qwen/Qwen3-VL-235B-A22B-Instruct,Qwen/Qwen3-VL-30B-A3B-Thinking,Qwen/Qwen3-VL-8B-Instruct
# 文本链（决策兜底，DeepSeek 失败时用，先进优先）
MODELSCOPE_TEXT_MODELS=Qwen/Qwen3.5-397B-A17B,Qwen/Qwen3.5-35B-A3B,Qwen/Qwen3.5-27B
#   SiliconFlow 硅基流动（Qwen3-VL-8B 走新用户免费 tokens；PaddleOCR-VL-1.5 云端OCR永久免费）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5

# 高德地图（距离计算，可选）
GAODE_API_KEY=

# Server酱（代码完成后配置）
SERVER_CHAN_SENDKEY=

# 家的坐标（高德坐标系）
HOME_LNG=103.93
HOME_LAT=30.78
